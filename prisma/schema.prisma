datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  EMPLOYEE
}

enum AttendanceStatus {
  GOOD
  LATE
  EARLY_LEAVE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OvertimeStatus {
  PENDING
  APPROVED
  REJECTED
}

model Company {
  id          String       @id @default(cuid())
  name        String
  logoUrl     String?
  phone       String?
  email       String?
  address     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  branches    Branch[]
  departments Department[]
  positions   Position[]
  employees   Employee[]
  shifts      Shift[]
  holidays    Holiday[]
  settings    Setting[]
  payrolls    Payroll[]
  telegramConfig TelegramConfig?
}

model Branch {
  id           String       @id @default(cuid())
  companyId    String
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  lat          Float
  lng          Float
  radiusMeters Int          @default(100)
  address      String?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  employees    Employee[]
  attendances  Attendance[]
  holidays     Holiday[]
  payrolls     Payroll[]
}

model Department {
  id        String     @id @default(cuid())
  companyId String
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  employees Employee[]
  payrolls  Payroll[]
}

model Position {
  id        String     @id @default(cuid())
  companyId String
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  employees Employee[]
}

model User {
  id           String     @id @default(cuid())
  email        String?    @unique
  phone        String?    @unique
  passwordHash String
  name         String
  role         Role       @default(EMPLOYEE)
  isActive     Boolean    @default(true)
  mustChangePassword Boolean @default(false)
  failedLoginAttempts Int   @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  resetToken   String?
  resetTokenExpiry DateTime?
  employee     Employee?
  auditLogs    AuditLog[]
}

model Shift {
  id           String          @id @default(cuid())
  companyId    String
  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  startTime    String          // e.g. "07:00"
  endTime      String          // e.g. "16:00"
  graceMinutes Int             @default(15)
  workDays     String          @default("1,2,3,4,5") // Monday to Friday by default
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  templates    ShiftTemplate[]
  employees    Employee[]
}

model ShiftTemplate {
  id        String   @id @default(cuid())
  shiftId   String
  shift     Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  name      String   // e.g. "ព្រឹក (Morning)", "ល្ងាច (Evening)"
  startTime String   // e.g. "07:00"
  endTime   String   // e.g. "16:00"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Employee {
  id             String          @id @default(cuid())
  companyId      String
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId         String?         @unique
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  code           String          @unique
  name           String
  phone          String?
  photoUrl       String?
  branchId       String
  branch         Branch          @relation(fields: [branchId], references: [id])
  departmentId   String
  department     Department      @relation(fields: [departmentId], references: [id])
  positionId     String
  position       Position        @relation(fields: [positionId], references: [id])
  shiftId        String
  shift          Shift           @relation(fields: [shiftId], references: [id])
  workingDays    String?         @default("1,2,3,4,5")
  shiftScheduleType String?      @default("TEMPLATE") // "TEMPLATE" | "CUSTOM"
  customStartTime   String?
  customEndTime     String?
  daySchedules      String?      // JSON string for per-day schedules
  customGraceMinutes Int?        @default(15)
  joinDate          DateTime?    @default(now())
  endProbationDate  DateTime?
  endContractDate   DateTime?
  otherBranchIds    String?      // Comma-separated allowed branch IDs
  employmentType    String?      @default("FULL_TIME") // FULL_TIME, PART_TIME, PROBATION, CONTRACT
  isActive       Boolean         @default(true)
  hiddenInReport Boolean         @default(false)
  pin            String?         @default("1234")
  mustChangePin  Boolean         @default(false)
  pinFailedAttempts Int          @default(0)
  pinLockedUntil    DateTime?
  baseSalary     Float           @default(200) // USD
  salaryType     String          @default("MONTHLY") // MONTHLY, DAILY, HOURLY
  workDaysPerMonth Int           @default(26)
  salaryEffectiveDate DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  attendances    Attendance[]
  leaveRequests  LeaveRequest[]
  overtimes      Overtime[]
  dayOffs        DayOff[]
  payrollItems   PayrollItem[]
  salaryHistories SalaryHistory[]
}

model Attendance {
  id            String           @id @default(cuid())
  employeeId    String
  employee      Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  branchId      String
  branch        Branch           @relation(fields: [branchId], references: [id])
  date          String           // YYYY-MM-DD
  checkInAt     DateTime?
  checkOutAt    DateTime?
  checkInLat    Float?
  checkInLng    Float?
  checkInAcc    Float?
  checkInPhoto  String?
  checkOutLat   Float?
  checkOutLng   Float?
  checkOutAcc   Float?
  checkOutPhoto String?
  status        AttendanceStatus @default(GOOD)
  isManual      Boolean          @default(false)
  note          String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([employeeId, date])
}

model LeaveType {
  id          String         @id @default(cuid())
  name        String
  daysAllowed Int            @default(18)
  requests    LeaveRequest[]
}

model LeaveRequest {
  id         String      @id @default(cuid())
  employeeId String
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  typeId     String
  type       LeaveType   @relation(fields: [typeId], references: [id])
  fromDate   DateTime
  toDate     DateTime
  reason     String?
  status     LeaveStatus @default(PENDING)
  approvedBy String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Overtime {
  id         String         @id @default(cuid())
  employeeId String
  employee   Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime
  hours      Float
  reason     String?
  status     OvertimeStatus @default(PENDING)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model Holiday {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  name      String
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DayOff {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime
  reason     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String?  @default("INFO")
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  details   String?
  createdAt DateTime @default(now())
}

model Setting {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payroll {
  id          String        @id @default(cuid())
  companyId   String
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId    String?
  branch      Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  departmentId String?
  department  Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  title       String?
  startDate   DateTime?
  endDate     DateTime?
  month       String        // YYYY-MM
  status      String        @default("PREPARE") // PREPARE, CHECKING, VERIFIED, APPROVED
  isFinalized Boolean       @default(false)
  finalizedAt DateTime?
  finalizedBy String?
  verifiedAt  DateTime?
  verifiedBy  String?
  approvedAt  DateTime?
  approvedBy  String?
  totalAmount Float         @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  items       PayrollItem[]
}

model PayrollItem {
  id            String    @id @default(cuid())
  payrollId     String
  payroll       Payroll   @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  baseSalary    Float     @default(0)
  salaryType    String    @default("MONTHLY")
  workDays      Int       @default(26)
  actualDays    Int       @default(0)
  proratedBase  Float?    @default(0)
  workDaysRatio Float?    @default(1.0)
  lateCount     Int       @default(0)
  latePenalty   Float     @default(0)
  absentDays    Int       @default(0)
  absentPenalty Float     @default(0)
  otHours       Float     @default(0)
  otPay         Float     @default(0)
  allowance     Float     @default(0)
  bonus         Float     @default(0)
  deduction     Float     @default(0)
  grossPay      Float     @default(0)
  taxDeduction  Float     @default(0)
  nssfDeduction Float     @default(0)
  netPay        Float     @default(0)
  note          String?
  isEdited      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([payrollId, employeeId])
}

model SalaryHistory {
  id               String   @id @default(cuid())
  employeeId       String
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  baseSalary       Float
  salaryType       String   @default("MONTHLY") // MONTHLY, DAILY, HOURLY
  workDaysPerMonth Int      @default(26)
  effectiveDate    DateTime @default(now())
  note             String?
  createdBy        String?
  createdAt        DateTime @default(now())

  @@index([employeeId, effectiveDate])
}

model TelegramConfig {
  id                 String   @id @default(cuid())
  companyId          String   @unique
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  botTokenEncrypted  String?
  chatId             String?
  isEnabled          Boolean  @default(false)
  notifyLate         Boolean  @default(false)
  notifyLeave        Boolean  @default(false)
  notifyDaily        Boolean  @default(false)
  dailySummaryTime   String   @default("18:00")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model RateLimitEntry {
  id          String    @id @default(cuid())
  key         String    @unique
  attempts    Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}
